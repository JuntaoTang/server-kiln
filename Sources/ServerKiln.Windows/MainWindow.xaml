<Window x:Class="ServerKiln.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ServerKiln.Windows"
 Title="ServerKiln" Style="{StaticResource {x:Type Window}}" Width="1220" Height="830" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen"
 Icon="AppIcon.ico" Closing="WindowClosing" IsVisibleChanged="VisibilityChanged">
 <Grid Margin="24,20,24,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,24">
   <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Image Source="AppIcon.ico" Width="43" Height="43" Margin="0,0,13,0" />
    <StackPanel><TextBlock Text="ServerKiln" FontSize="25" FontWeight="SemiBold" />
     <TextBlock Text="{Binding [Tagline], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
    </StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <TextBlock Text="{Binding FleetSummary}" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Margin="0,0,18,0" />
    <Button Content="EN / 中" Click="ToggleLanguage" Padding="10,7" Margin="0,0,7,0" AutomationProperties.Name="Language" />
    <Button Content="◐" Click="ToggleTheme" Padding="12,7" Margin="0,0,7,0" AutomationProperties.Name="Theme" />
    <Button Content="{Binding [Settings], Source={x:Static local:Localizer.Current}}" Click="OpenSettings" />
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="252" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Grid Grid.Column="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="{Binding [Fleet], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" Margin="2,0,0,12" FontWeight="SemiBold" />
    <ListBox Grid.Row="1" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" AutomationProperties.Name="Servers">
     <ListBox.ItemTemplate><DataTemplate>
      <StackPanel>
       <DockPanel><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" DockPanel.Dock="Right" FontSize="11" Margin="8,3,0,0" />
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
       </DockPanel>
       <TextBlock Text="{Binding Target}" Style="{StaticResource Caption}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
       <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
      </StackPanel>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" Margin="0,14,0,0">
     <Button Content="{Binding [Add], Source={x:Static local:Localizer.Current}}" Click="AddServer" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
     <Button Content="{Binding [Import], Source={x:Static local:Localizer.Current}}" Click="ImportServers" />
    </StackPanel>
   </Grid>
   <Grid Grid.Column="2">
    <Grid Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center">
     <StackPanel MaxWidth="480">
      <TextBlock Text="{Binding [NoServers], Source={x:Static local:Localizer.Current}}" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="{Binding [Welcome], Source={x:Static local:Localizer.Current}}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="25" Margin="0,18,0,22" />
      <TextBlock Text="ssh gpu-lab" FontFamily="Consolas" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
     </StackPanel>
    </Grid>
    <Grid Visibility="{Binding DetailVisibility}">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <Grid Margin="0,0,0,15">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="{Binding SelectedServer.Name}" FontSize="26" FontWeight="SemiBold" />
       <TextBlock Text="{Binding SelectedServer.Subtitle}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="{Binding [Refresh], Source={x:Static local:Localizer.Current}}" Click="Refresh" Margin="0,0,7,0" />
       <Button Content="{Binding [Edit], Source={x:Static local:Localizer.Current}}" Click="EditServer" Margin="0,0,7,0" />
       <Button Content="{Binding [Remove], Source={x:Static local:Localizer.Current}}" Click="RemoveServer" />
      </StackPanel>
     </Grid>
     <Border Grid.Row="1" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" Padding="12" Margin="0,0,0,14" Visibility="{Binding SelectedServer.ErrorVisibility}">
      <StackPanel><TextBlock Text="{Binding SelectedServer.Error}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />
       <TextBlock Text="{Binding [RetryHint], Source={x:Static local:Localizer.Current}}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,6,0,0" />
      </StackPanel>
     </Border>
     <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,-10,15">
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,10,0"><StackPanel>
       <TextBlock Text="{Binding [Cpu], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" />
       <TextBlock Text="{Binding SelectedServer.Cpu}" FontSize="26" Margin="0,7,0,4" /><TextBlock Text="{Binding SelectedServer.Cores}" Style="{StaticResource Caption}" />
      </StackPanel></Border>
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,10,0"><StackPanel>
       <TextBlock Text="{Binding [Ram], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" />
       <TextBlock Text="{Binding SelectedServer.Ram}" FontSize="26" Margin="0,7,0,4" /><TextBlock Text="{Binding SelectedServer.RamSize}" Style="{StaticResource Caption}" />
      </StackPanel></Border>
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,10,0"><StackPanel>
       <TextBlock Text="{Binding [Disk], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" />
       <TextBlock Text="{Binding SelectedServer.Disk}" FontSize="26" Margin="0,7,0,4" /><TextBlock Text="{Binding SelectedServer.DiskSize}" Style="{StaticResource Caption}" />
      </StackPanel></Border>
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,10,0"><StackPanel>
       <TextBlock Text="{Binding [Network], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" />
       <TextBlock Text="{Binding SelectedServer.Rx}" FontSize="17" Margin="0,10,0,8" /><TextBlock Text="{Binding SelectedServer.Tx}" Style="{StaticResource Caption}" />
      </StackPanel></Border>
     </UniformGrid>
     <TabControl Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" SelectionChanged="TabChanged" x:Name="DetailTabs">
      <TabControl.Resources>
       <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Padding" Value="15,9" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
         <Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="{DynamicResource BackgroundBrush}"><ContentPresenter ContentSource="Header" /></Border>
         <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style>
      </TabControl.Resources>
      <TabItem Header="{Binding [Overview], Source={x:Static local:Localizer.Current}}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
         <TextBlock Text="{Binding SelectedServer.GpuMessage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
         <ItemsControl ItemsSource="{Binding SelectedServer.Gpus}">
          <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource RaisedBrush}" Padding="14" CornerRadius="7" Margin="0,0,0,10">
           <StackPanel><DockPanel><TextBlock Text="{Binding Telemetry}" DockPanel.Dock="Right" Style="{StaticResource Caption}" /><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /></DockPanel>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
             <StackPanel><DockPanel><TextBlock Text="{Binding Utilization}" DockPanel.Dock="Right" /><TextBlock Text="{Binding [GpuUse], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" /></DockPanel>
              <ProgressBar Height="5" Margin="0,7,0,0" Value="{Binding UtilizationValue, Mode=OneWay}" Maximum="100" Foreground="{DynamicResource GreenBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0" />
             </StackPanel>
             <StackPanel Grid.Column="2"><DockPanel><TextBlock Text="{Binding Memory}" DockPanel.Dock="Right" FontSize="12" /><TextBlock Text="{Binding [Vram], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" /></DockPanel>
              <ProgressBar Height="5" Margin="0,7,0,0" Value="{Binding MemoryValue, Mode=OneWay}" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" BorderThickness="0" />
             </StackPanel>
            </Grid>
           </StackPanel>
          </Border></DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <DockPanel Margin="0,15,0,10"><Button DockPanel.Dock="Right" Content="{Binding [OpenSsh], Source={x:Static local:Localizer.Current}}" Click="OpenTerminal" Padding="10,5" /><TextBlock Text="{Binding [Processes], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" VerticalAlignment="Center" /></DockPanel>
         <DataGrid ItemsSource="{Binding SelectedServer.Processes}" MinHeight="110" MaxHeight="240" x:Name="ProcessGrid">
          <DataGrid.Columns>
           <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65" />
           <DataGridTextColumn Header="{Binding [User], Source={x:Static local:Localizer.Current}}" Binding="{Binding User}" Width="85" />
           <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="65" />
           <DataGridTextColumn Header="RAM" Binding="{Binding Ram}" Width="85" />
           <DataGridTextColumn Header="{Binding [Command], Source={x:Static local:Localizer.Current}}" Binding="{Binding Command}" Width="*" MinWidth="180" />
          </DataGrid.Columns>
          <DataGrid.ContextMenu><ContextMenu><MenuItem Header="{Binding [Copy], Source={x:Static local:Localizer.Current}}" Click="CopyCommand" /></ContextMenu></DataGrid.ContextMenu>
          <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}" /></Style></DataGrid.RowStyle>
         </DataGrid>
         <TextBlock Text="{Binding [Jobs], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" Margin="0,22,0,10" />
         <TextBlock Text="{Binding SelectedServer.JobMessage}" Style="{StaticResource Caption}" />
         <ItemsControl ItemsSource="{Binding SelectedServer.Jobs}"><ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel>
           <TextBlock Text="{Binding Command}" FontFamily="Consolas, Microsoft YaHei UI" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
           <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,5,0,0" />
          </StackPanel></Border>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
       </ScrollViewer>
      </TabItem>
      <TabItem Header="{Binding [History], Source={x:Static local:Localizer.Current}}" x:Name="HistoryTab">
       <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
         <Button Content="{Binding [24h], Source={x:Static local:Localizer.Current}}" Tag="1" Click="ChangeHistoryRange" Margin="0,0,7,0" />
         <Button Content="{Binding [7d], Source={x:Static local:Localizer.Current}}" Tag="7" Click="ChangeHistoryRange" Margin="0,0,7,0" />
         <Button Content="{Binding [30d], Source={x:Static local:Localizer.Current}}" Tag="30" Click="ChangeHistoryRange" />
        </StackPanel>
        <local:HistoryChart x:Name="Chart" Grid.Row="1" MinHeight="190" />
        <TextBlock Grid.Row="2" Text="{Binding [ChartLegend], Source={x:Static local:Localizer.Current}}" Foreground="{DynamicResource MutedBrush}" Margin="0,16,0,0" TextWrapping="Wrap" />
       </Grid>
      </TabItem>
     </TabControl>
    </Grid>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,18,0,0">
   <TextBlock DockPanel.Dock="Right" Text="{Binding [TrayHint], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" Margin="15,0,0,0" />
   <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
  </DockPanel>
 </Grid>
</Window>
