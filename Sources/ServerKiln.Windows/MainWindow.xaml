<Window x:Class="ServerKiln.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ServerKiln.Windows"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="ServerKiln" Style="{StaticResource {x:Type Window}}" Width="1220" Height="830" MinWidth="980" MinHeight="650"
 WindowStyle="None" WindowStartupLocation="CenterScreen" Icon="AppIcon.ico" Closing="WindowClosing" IsVisibleChanged="VisibilityChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition /></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Border Grid.RowSpan="3" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
   <Grid Margin="12,8,12,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="8,2,0,16">
     <Image Source="AppIcon.ico" Width="22" Height="22" Margin="0,0,8,0" />
     <TextBlock Text="ServerKiln" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="8,0,0,8" Height="32">
     <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding [Fleet], Source={x:Static local:Localizer.Current}}" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="{Binding Servers.Count}" Style="{StaticResource Caption}" Margin="8,2,0,0" /></StackPanel>
     <Button Grid.Column="1" Content="{Binding [ImportShort], Source={x:Static local:Localizer.Current}}" Style="{StaticResource GhostButton}" Click="ImportServers" Padding="8,4" ToolTip="{Binding [Import], Source={x:Static local:Localizer.Current}}" />
     <Button Grid.Column="2" Content="&#xE710;" Style="{StaticResource IconButton}" Click="AddServer" ToolTip="{Binding [Add], Source={x:Static local:Localizer.Current}}" AutomationProperties.Name="{Binding [Add], Source={x:Static local:Localizer.Current}}" />
    </Grid>
    <ListBox Grid.Row="2" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" AutomationProperties.Name="{Binding [Fleet], Source={x:Static local:Localizer.Current}}">
     <ListBox.ItemTemplate><DataTemplate>
      <Grid ToolTip="{Binding Target}"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition /></Grid.ColumnDefinitions>
       <Border Width="30" Height="30" Background="{DynamicResource RaisedBrush}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
       <StackPanel Grid.Column="1">
        <DockPanel><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" DockPanel.Dock="Right" FontSize="13" Margin="8,1,0,0" /><TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /></DockPanel>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
       </StackPanel>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
     <TextBlock Text="{Binding FleetSummary}" Style="{StaticResource Caption}" FontSize="13" Margin="8,0,0,12" />
     <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <Button Style="{StaticResource GhostButton}" Click="OpenSettings" HorizontalAlignment="Left" Padding="8,4" Content="{Binding [Settings], Source={x:Static local:Localizer.Current}}" Foreground="{DynamicResource MutedBrush}" />
       <Button Grid.Column="1" Content="EN / 中" Click="ToggleLanguage" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="13" Foreground="{DynamicResource MutedBrush}" ToolTip="{Binding [Language], Source={x:Static local:Localizer.Current}}" AutomationProperties.Name="{Binding [Language], Source={x:Static local:Localizer.Current}}" />
      </Grid>
     </Border>
    </StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
   <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeWindow" ToolTip="{Binding [Minimize], Source={x:Static local:Localizer.Current}}" AutomationProperties.Name="{Binding [Minimize], Source={x:Static local:Localizer.Current}}" />
   <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeWindow" ToolTip="{Binding [Maximize], Source={x:Static local:Localizer.Current}}" AutomationProperties.Name="{Binding [Maximize], Source={x:Static local:Localizer.Current}}" />
   <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="HideWindow" ToolTip="{Binding [Close], Source={x:Static local:Localizer.Current}}" AutomationProperties.Name="{Binding [Close], Source={x:Static local:Localizer.Current}}" />
  </StackPanel>
  <Grid Grid.Column="1" Grid.Row="1" Margin="24,0,24,0">
   <StackPanel Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
    <TextBlock Text="{Binding [NoServers], Source={x:Static local:Localizer.Current}}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" />
    <TextBlock Text="{Binding [Welcome], Source={x:Static local:Localizer.Current}}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="22" Margin="0,12,0,24" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
     <Button Content="{Binding [Add], Source={x:Static local:Localizer.Current}}" Style="{StaticResource PrimaryButton}" Click="AddServer" Margin="0,0,8,0" />
     <Button Content="{Binding [Import], Source={x:Static local:Localizer.Current}}" Click="ImportServers" />
    </StackPanel>
   </StackPanel>
   <Grid Visibility="{Binding DetailVisibility}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
    <Grid Margin="0,4,0,16">
     <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding SelectedServer.Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360" ToolTip="{Binding SelectedServer.Target}" />
       <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{Binding SelectedServer.StatusBrush}" Margin="0,0,4,0" /><TextBlock Text="{Binding SelectedServer.Status}" Style="{StaticResource Caption}" /></StackPanel>
      </Grid>
      <TextBlock Text="{Binding SelectedServer.Subtitle}" Style="{StaticResource Caption}" Margin="0,4,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedServer.Subtitle}" />
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
      <Button Click="OpenTerminal" Padding="11,4" Margin="0,0,8,0" ToolTip="{Binding [OpenSsh], Source={x:Static local:Localizer.Current}}" AutomationProperties.Name="{Binding [OpenSsh], Source={x:Static local:Localizer.Current}}">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Text="{Binding [Terminal], Source={x:Static local:Localizer.Current}}" /></StackPanel>
      </Button>
      <Button Content="&#xE72C;" Click="Refresh" Style="{StaticResource IconButton}" Margin="0,0,2,0" ToolTip="{Binding [Refresh], Source={x:Static local:Localizer.Current}}" AutomationProperties.Name="{Binding [Refresh], Source={x:Static local:Localizer.Current}}" />
      <Button x:Name="ServerMenuButton" Content="&#xE712;" Click="OpenServerMenu" Style="{StaticResource IconButton}" ToolTip="{Binding [More], Source={x:Static local:Localizer.Current}}" AutomationProperties.Name="{Binding [More], Source={x:Static local:Localizer.Current}}">
       <Button.ContextMenu><ContextMenu>
        <MenuItem Header="{Binding [Edit], Source={x:Static local:Localizer.Current}}" Click="EditServer" />
        <MenuItem Header="{Binding [FirstConnect], Source={x:Static local:Localizer.Current}}" Click="OpenTerminal" />
        <Separator />
        <MenuItem Header="{Binding [Remove], Source={x:Static local:Localizer.Current}}" Click="RemoveServer" Foreground="{DynamicResource DangerBrush}" />
       </ContextMenu></Button.ContextMenu>
      </Button>
     </StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource DangerSoftBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,12" Visibility="{Binding SelectedServer.ErrorVisibility}">
     <StackPanel>
      <TextBlock Text="{Binding SelectedServer.ErrorTitle}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,4" />
      <TextBlock Text="{Binding SelectedServer.ErrorHint}" TextWrapping="Wrap" Style="{StaticResource Caption}" LineHeight="20" />
      <Expander Header="{Binding [Details], Source={x:Static local:Localizer.Current}}" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"><TextBlock Text="{Binding SelectedServer.Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" FontSize="13" Margin="0,4,0,0" /></Expander>
      <Button Content="{Binding [FirstConnect], Source={x:Static local:Localizer.Current}}" Click="OpenTerminal" HorizontalAlignment="Left" Padding="8,4" Margin="0,8,0,0" />
     </StackPanel>
    </Border>
    <TabControl Grid.Row="2" SelectionChanged="TabChanged" x:Name="DetailTabs">
     <TabItem Header="{Binding [Overview], Source={x:Static local:Localizer.Current}}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,24,8,0">
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,24" Margin="0,0,0,24">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,24,0"><TextBlock Text="{Binding [Cpu], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" /><TextBlock Text="{Binding SelectedServer.Cpu}" Style="{StaticResource MetricValue}" /><TextBlock Text="{Binding SelectedServer.Cores}" Style="{StaticResource Caption}" /></StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Margin="0,4" />
          <StackPanel Grid.Column="2" Margin="24,0"><TextBlock Text="{Binding [Ram], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" /><TextBlock Text="{Binding SelectedServer.Ram}" Style="{StaticResource MetricValue}" /><TextBlock Text="{Binding SelectedServer.RamSize}" Style="{StaticResource Caption}" /></StackPanel>
          <Border Grid.Column="3" Background="{DynamicResource BorderBrush}" Margin="0,4" />
          <StackPanel Grid.Column="4" Margin="24,0"><TextBlock Text="{Binding [Disk], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" /><TextBlock Text="{Binding SelectedServer.Disk}" Style="{StaticResource MetricValue}" /><TextBlock Text="{Binding SelectedServer.DiskSize}" Style="{StaticResource Caption}" /></StackPanel>
          <Border Grid.Column="5" Background="{DynamicResource BorderBrush}" Margin="0,4" />
          <StackPanel Grid.Column="6" Margin="24,0,0,0"><TextBlock Text="{Binding [Network], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" /><TextBlock Text="{Binding SelectedServer.Rx}" FontSize="17" Margin="0,12,0,8" /><TextBlock Text="{Binding SelectedServer.Tx}" Style="{StaticResource Caption}" /></StackPanel>
         </Grid>
        </Border>
        <TextBlock Text="GPU" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" Visibility="{Binding SelectedServer.GpuVisibility}" />
        <TextBlock Text="{Binding SelectedServer.GpuMessage}" Visibility="{Binding SelectedServer.GpuMessageVisibility}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16" />
        <Grid Visibility="{Binding SelectedServer.GpuVisibility}">
         <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
         <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding [Device], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" /><TextBlock Grid.Column="1" Text="{Binding [Utilization], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" /><TextBlock Grid.Column="2" Text="{Binding [Vram], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" /><TextBlock Grid.Column="3" Text="{Binding [Temperature], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" /><TextBlock Grid.Column="4" Text="{Binding [Power], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" />
          </Grid>
         </Border>
         <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedServer.Gpus}"><ItemsControl.ItemTemplate><DataTemplate>
          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,12">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="68" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Model}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" /><TextBlock Text="{Binding Index}" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="{Binding Utilization}" /><ProgressBar Margin="0,8,0,0" Value="{Binding UtilizationValue, Mode=OneWay}" /></StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,24,0" VerticalAlignment="Center"><TextBlock Text="{Binding Memory}" FontSize="13" /><ProgressBar Margin="0,8,0,0" Value="{Binding MemoryValue, Mode=OneWay}" Foreground="{DynamicResource SecondaryMetricBrush}" /></StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding Temperature}" VerticalAlignment="Center" FontSize="13" /><TextBlock Grid.Column="4" Text="{Binding Power}" VerticalAlignment="Center" FontSize="13" />
           </Grid>
          </Border>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </Grid>
        <TextBlock Text="{Binding [Processes], Source={x:Static local:Localizer.Current}}" Style="{StaticResource SectionTitle}" Margin="0,24,0,12" />
        <DataGrid ItemsSource="{Binding SelectedServer.Processes}" MinHeight="110" MaxHeight="260" x:Name="ProcessGrid">
         <DataGrid.Columns>
          <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="72" /><DataGridTextColumn Header="{Binding [User], Source={x:Static local:Localizer.Current}}" Binding="{Binding User}" Width="95" /><DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="72" /><DataGridTextColumn Header="RAM" Binding="{Binding Ram}" Width="90" /><DataGridTextColumn Header="{Binding [Command], Source={x:Static local:Localizer.Current}}" Binding="{Binding Command}" ElementStyle="{StaticResource CommandText}" Width="*" MinWidth="180" />
         </DataGrid.Columns>
         <DataGrid.ContextMenu><ContextMenu><MenuItem Header="{Binding [Copy], Source={x:Static local:Localizer.Current}}" Click="CopyCommand" /></ContextMenu></DataGrid.ContextMenu>
         <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}" /></Style></DataGrid.RowStyle>
        </DataGrid>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="{Binding [Jobs], Source={x:Static local:Localizer.Current}}" x:Name="JobsTab">
      <Grid Margin="0,16,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
       <TextBlock Text="{Binding SelectedServer.JobMessage}" Style="{StaticResource Caption}" />
       <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedServer.Jobs}">
        <DataGrid.Columns>
         <DataGridTextColumn Header="{Binding [Command], Source={x:Static local:Localizer.Current}}" Binding="{Binding Command}" ElementStyle="{StaticResource CommandText}" Width="*" MinWidth="180" /><DataGridTextColumn Header="{Binding [User], Source={x:Static local:Localizer.Current}}" Binding="{Binding User}" Width="90" /><DataGridTextColumn Header="GPU" Binding="{Binding Gpus}" Width="66" /><DataGridTextColumn Header="{Binding [Started], Source={x:Static local:Localizer.Current}}" Binding="{Binding Started}" Width="116" /><DataGridTextColumn Header="{Binding [Ended], Source={x:Static local:Localizer.Current}}" Binding="{Binding Ended}" Width="116" />
        </DataGrid.Columns>
        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}" /></Style></DataGrid.RowStyle>
       </DataGrid>
      </Grid>
     </TabItem>
     <TabItem Header="{Binding [History], Source={x:Static local:Localizer.Current}}" x:Name="HistoryTab">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="0,16,8,0">
        <WrapPanel Margin="0,0,0,16">
         <Border Background="{DynamicResource RaisedBrush}" CornerRadius="4" Padding="2" Margin="0,0,16,4"><StackPanel Orientation="Horizontal">
          <Button x:Name="RangeLive" Style="{StaticResource SegmentButton}" Content="{Binding [10m], Source={x:Static local:Localizer.Current}}" Tag="TenMinutes" Click="ChangeHistoryRange" /><Button x:Name="RangeDay" Style="{StaticResource SegmentButton}" Content="{Binding [24h], Source={x:Static local:Localizer.Current}}" Tag="Day" Click="ChangeHistoryRange" /><Button x:Name="RangeWeek" Style="{StaticResource SegmentButton}" Content="{Binding [7d], Source={x:Static local:Localizer.Current}}" Tag="Week" Click="ChangeHistoryRange" /><Button x:Name="RangeMonth" Style="{StaticResource SegmentButton}" Content="{Binding [30d], Source={x:Static local:Localizer.Current}}" Tag="Month" Click="ChangeHistoryRange" />
         </StackPanel></Border>
         <Border Background="{DynamicResource RaisedBrush}" CornerRadius="4" Padding="2" Margin="0,0,16,4"><StackPanel Orientation="Horizontal"><Button x:Name="ModeOverall" Style="{StaticResource SegmentButton}" Content="{Binding [Overall], Source={x:Static local:Localizer.Current}}" Tag="False" Click="ChangeHistoryMode" /><Button x:Name="ModePerGpu" Style="{StaticResource SegmentButton}" Content="{Binding [PerGpu], Source={x:Static local:Localizer.Current}}" Tag="True" Click="ChangeHistoryMode" /></StackPanel></Border>
         <StackPanel x:Name="GpuMetricPicker" Visibility="Collapsed"><Border Background="{DynamicResource RaisedBrush}" CornerRadius="4" Padding="2" Margin="0,0,0,4"><StackPanel Orientation="Horizontal"><Button x:Name="MetricUtilization" Style="{StaticResource SegmentButton}" Content="{Binding [GpuUse], Source={x:Static local:Localizer.Current}}" Tag="Utilization" Click="ChangeHistoryMetric" /><Button x:Name="MetricMemory" Style="{StaticResource SegmentButton}" Content="{Binding [Vram], Source={x:Static local:Localizer.Current}}" Tag="Memory" Click="ChangeHistoryMetric" /></StackPanel></Border></StackPanel>
        </WrapPanel>
        <local:HistoryChart x:Name="Chart" Height="340" Margin="0,4,0,0" />
        <TextBlock x:Name="HistoryHint" Style="{StaticResource Caption}" Margin="0,16,0,16" TextWrapping="Wrap" />
       </StackPanel>
      </ScrollViewer>
     </TabItem>
    </TabControl>
   </Grid>
  </Grid>
  <DockPanel Grid.Column="1" Grid.Row="2" Margin="24,12,24,12">
   <TextBlock DockPanel.Dock="Right" Text="{Binding [TrayHint], Source={x:Static local:Localizer.Current}}" Style="{StaticResource Caption}" FontSize="13" Margin="16,0,0,0" />
   <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
  </DockPanel>
 </Grid>
</Window>
